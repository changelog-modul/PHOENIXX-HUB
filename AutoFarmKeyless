local frozen = false

local function freezeBackpackUI()
    if frozen then return end
    frozen = true

    local original = backpackGui:FindFirstChild("Backpack")
    if not original then return end

    local clone = original:Clone()
    clone.Name = "FrozenBackpack"
    clone.Parent = backpackGui
    clone.Visible = true

    original.Visible = false

    RunService.RenderStepped:Connect(function()
        if clone then
            clone.Visible = true
        end
    end)
end

