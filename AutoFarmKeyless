--====================================================
-- TOOL CLEAN (UNCHANGED)
--====================================================

local function disableEntityGui(tool)
    for _,v in ipairs(tool:GetDescendants()) do
        if v:IsA("BillboardGui") or v.Name == "EntityGUI" then
            v.Enabled = false
        end
    end
end

local function breakToolJoints(tool)
    for _,v in ipairs(tool:GetDescendants()) do
        if v:IsA("Weld")
        or v:IsA("Motor6D")
        or v:IsA("WeldConstraint") then
            v:Destroy()
        end
    end
end

local function silentEquip(tool)
    local char = getChar()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    blockAnim(hum)

    disableEntityGui(tool)

    for _,v in ipairs(tool:GetDescendants()) do
        if v:IsA("BasePart") then
            v.LocalTransparencyModifier = 1
            v.Transparency = 1
            v.CanCollide = false
            v.Massless = true
        end
    end

    hum:EquipTool(tool)

    task.defer(function()
        breakToolJoints(tool)
    end)

    tool.DescendantAdded:Connect(function(obj)
        if obj:IsA("BillboardGui") or obj.Name == "EntityGUI" then
            obj.Enabled = false
        end

        if obj:IsA("Weld")
        or obj:IsA("Motor6D")
        or obj:IsA("WeldConstraint") then
            obj:Destroy()
        end
    end)
end

local function unequipAll()
    local char = getChar()
    for _,v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then
            v.Parent = backpack
        end
    end
end

