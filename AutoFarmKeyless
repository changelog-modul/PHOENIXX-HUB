local inv = player.PlayerGui:WaitForChild("NewInventory")

-- METHOD 1: Kill Tween
for _,v in ipairs(inv:GetDescendants()) do
    if v:IsA("GuiObject") then
        pcall(function()
            v:TweenSize(v.Size, "Out", "Linear", 0, true)
            v:TweenPosition(v.Position, "Out", "Linear", 0, true)
        end)
    end
end

-- METHOD 2: Lock Size/Position
for _,v in ipairs(inv:GetDescendants()) do
    if v:IsA("GuiObject") then
        local size = v.Size
        local pos = v.Position

        v:GetPropertyChangedSignal("Size"):Connect(function()
            v.Size = size
        end)

        v:GetPropertyChangedSignal("Position"):Connect(function()
            v.Position = pos
        end)
    end
end

-- METHOD 3: Remove UI Effects
for _,v in ipairs(inv:GetDescendants()) do
    if v:IsA("UIScale")
    or v:IsA("UIGradient")
    or v:IsA("UIStroke") then
        v:Destroy()
    end
end

-- METHOD 4: Disable UI Scripts
for _,v in ipairs(inv:GetDescendants()) do
    if v:IsA("LocalScript") then
        v.Disabled = true
    end
end

-- METHOD 5: Anti Respawn
inv.DescendantAdded:Connect(function(obj)
    if obj:IsA("UIScale")
    or obj:IsA("UIGradient")
    or obj:IsA("UIStroke") then
        obj:Destroy()
    end

    if obj:IsA("LocalScript") then
        obj.Disabled = true
    end
end)

--====================================================
-- SOUND KILL
--====================================================

local function killTargetSounds()
    local effects = SoundService:FindFirstChild("Effects")
    if not effects then return end

    for _,name in ipairs({"Notification","ErrorSound"}) do
        local s = effects:FindFirstChild(name)
        if s and s:IsA("Sound") then
            s.Volume = 0
            s:Stop()
        end
    end
end

killTargetSounds()

SoundService.DescendantAdded:Connect(function(obj)
    if obj.Name == "Notification" or obj.Name == "ErrorSound" then
        task.wait()
        killTargetSounds()
    end
end)

