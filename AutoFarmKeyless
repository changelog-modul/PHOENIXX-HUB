local function getMutation(tool)
    local m = tool:GetAttribute("Mutation")

    if not m or m == "" then
        return "normal"
    end

    m = string.lower(tostring(m))

    if m == "none" then
        return "normal"
    end

    return m
end

local function isWhitelistedName(tool)
    return brainrotWhitelist[tool.Name] ~= nil
end

local function isWhitelisted(tool)
    local data = brainrotWhitelist[tool.Name]
    if not data then return false end

    local mutation = getMutation(tool)

    -- 🔥 wildcard (semua mutation)
    if data.mutations["*"] then
        return true
    end

    return data.mutations[mutation] == true
end

local function getSortedTools()
    local list = {}

    for _,tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool")
        and not isWeightTool(tool)
        and brainrotWhitelist[tool.Name] then

            table.insert(list, tool)
        end
    end

    table.sort(list, function(a,b)
        local ca = brainrotWhitelist[a.Name].chance or 0
        local cb = brainrotWhitelist[b.Name].chance or 0
        return ca < cb -- 🔥 terkecil dulu
    end)

    return list
end


