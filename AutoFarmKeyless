--====================================================
-- 🎬 SUPER SILENT EQUIP
--====================================================

local function getChar()
    return player.Character or player.CharacterAdded:Wait()
end

local animHooked = false

local function hookAnim(hum)
    if animHooked then return end
    animHooked = true

    hum.AnimationPlayed:Connect(function(track)
        local name = string.lower(track.Name)
        if string.find(name,"tool")
        or string.find(name,"equip")
        or string.find(name,"hold") then
            track:Stop()
        end
    end)
end

local function hideTool(tool)
    for _,v in ipairs(tool:GetDescendants()) do
        if v:IsA("BasePart") then
            v.LocalTransparencyModifier = 1
            v.Transparency = 1
            v.CanCollide = false
            v.Size = Vector3.new(0.05,0.05,0.05)
        elseif v:IsA("Decal") then
            v.Transparency = 1
        end
    end
end

local function isWeightTool(tool)
    return weightFolder:FindFirstChild(tool.Name) ~= nil
end

local function silentEquip(tool)
    local char = getChar()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    hookAnim(hum)

    hideTool(tool) -- sebelum equip
    hum:EquipTool(tool)

    task.defer(function()
        hideTool(tool)
    end)
end

local function unequipAll()
    local char = getChar()
    for _,v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then
            v.Parent = backpack
        end
    end
end

local function getRarity(tool)
    local model = tool:FindFirstChild(tool.Name)

    if model
    and model:FindFirstChild("Root")
    and model.Root:FindFirstChild("EntityGUI")
    and model.Root.EntityGUI:FindFirstChild("Frame")
    and model.Root.EntityGUI.Frame:FindFirstChild("RarityLabel") then
        return string.lower(model.Root.EntityGUI.Frame.RarityLabel.Text)
    end
end

